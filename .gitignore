# Motif ANCRE : sans le '/' initial il attrapait aussi src/rsl/data/,
# c'est-a-dire toute la couche donnees. Voir lecon L5.
/data/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
runs/
# `runs/` est la sortie de `--out` : un rapport qu'on regarde et qu'on jette.
# `essais/` en est l'oppose et reste VERSIONNE - c'est le compteur du
# Deflated Sharpe, et un essai perdu gonfle le DSR de tous les autres.
*.egg-info/
.hypothesis/

# Racine des donnees propre a chaque machine. Motif ANCRE : voir lecon L5.
/.env

# Etat d'interface local d'Obsidian : panneaux ouverts, taille de fenetre.
# Change a chaque ouverture et entre en conflit entre machines. Les AUTRES
# fichiers de .obsidian/ sont versionnes : ce sont des reglages partages.
/.obsidian/workspace.json
