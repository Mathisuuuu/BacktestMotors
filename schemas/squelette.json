{
  "cles_de_rules": [
    "entry_long",
    "exit_long",
    "entry_short",
    "exit_short",
    "stop_loss",
    "take_profit",
    "entry_limit",
    "entry_stop"
  ],
  "contraintes": [
    "Un meme instrument ne peut apparaitre qu'une fois dans `data` : deux",
    "granularites du meme symbole sont refusees ('X apparait deux fois').",
    "",
    "`path` doit etre RELATIF a la racine declaree par la variable d'environnement",
    "RSL_DATA_DIR (ou un fichier `.env`). Un chemin absolu fonctionne mais n'est",
    "pas portable, et fait diverger le `config_hash` entre deux machines.",
    "",
    "`root` doit figurer dans la liste `instruments` : c'est elle qui determine",
    "multiplicateur, tick et frais.",
    "",
    "Pour `macd@1`, `fast` doit etre strictement inferieur a `slow`.",
    "",
    "Pour le noeud `rolling`, les statistiques `stdev`, `zscore`, `var` et `slope`",
    "exigent `window >= 2` : une observation unique n'a ni dispersion ni pente.",
    "",
    "Les fenetres sont en NOMBRE DE BARRES, jamais en duree. Sur des donnees",
    "minute trouees, `window: 60` ne fait pas une heure.",
    "",
    "`lag_bars` vaut au minimum 1 : une execution sur la barre qui a produit le",
    "signal serait du look-ahead, et le moteur la refuse.",
    "",
    "Les strategies marquees `cross_sectional: true` ignorent `symbol` et",
    "travaillent sur tout l'univers declare dans `data`."
  ],
  "engendre_par": "rsl squelette",
  "format": "rsl-squelette@1",
  "instruments": [
    "6A",
    "6B",
    "6E",
    "6J",
    "CL",
    "ES",
    "FDAX",
    "GC",
    "NQ",
    "YM"
  ],
  "mode_d_emploi": [
    "Ce fichier decrit CE QU'ON PEUT ECRIRE, pas un backtest. Pour en produire un,",
    "recopier la forme de `specification` en remplacant chaque descripteur par une",
    "valeur prise dans son `choix`, ou conforme a son `type`.",
    "",
    "Un descripteur est un objet portant une cle `type`. Il n'apparait jamais dans",
    "une specification finale : il indique quoi mettre a sa place.",
    "",
    "Une cle `requis: true` doit etre presente. Une cle qui porte un `defaut` peut",
    "etre omise ; elle vaudra ce defaut.",
    "",
    "Le type `noeud` est recursif : y ecrire n'importe quel objet du catalogue",
    "`noeuds`, choisi par sa cle `type`. Un noeud contient souvent d'autres noeuds.",
    "C'est de cette recursion que vient toute l'expressivite du vocabulaire.",
    "",
    "Les seules feuilles d'un arbre de noeuds - celles qui n'en contiennent pas",
    "d'autres - sont `constant`, `price`, `time`, `position` et `primitive`.",
    "Un arbre qui ne se termine pas par des feuilles est invalide.",
    "",
    "`primitive` prend une `ref` du catalogue `primitives` et ses `params`. Elle ne",
    "lit QUE des champs de prix : pour appliquer un calcul a une expression",
    "quelconque, utiliser le noeud `rolling`.",
    "",
    "Toute erreur est refusee, jamais ignoree : cle inconnue, valeur hors `choix`,",
    "`ref` inexistante. La commande rend alors le code de sortie 1 et nomme ce",
    "qu'elle attendait."
  ],
  "noeuds": {
    "all_of": {
      "champs": {
        "operands": {
          "element": {
            "type": "noeud"
          },
          "min_elements": 1,
          "requis": true,
          "type": "liste"
        }
      },
      "resume": "Conjonction : vrai si tous les sous-signaux sont vrais."
    },
    "any_of": {
      "champs": {
        "operands": {
          "element": {
            "type": "noeud"
          },
          "min_elements": 1,
          "requis": true,
          "type": "liste"
        }
      },
      "resume": "Disjonction : vrai si au moins un sous-signal est vrai."
    },
    "arith": {
      "champs": {
        "left": {
          "requis": true,
          "type": "noeud"
        },
        "op": {
          "choix": [
            "+",
            "-",
            "*",
            "/"
          ],
          "requis": true,
          "type": "choix"
        },
        "right": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "Operation arithmetique entre deux sous-signaux."
    },
    "bars_since": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        },
        "lookback": {
          "min": 1,
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Nombre de barres depuis la derniere fois qu'une condition etait vraie."
    },
    "compare": {
      "champs": {
        "left": {
          "requis": true,
          "type": "noeud"
        },
        "op": {
          "choix": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ],
          "requis": true,
          "type": "choix"
        },
        "right": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "Comparaison de deux sous-signaux, resultat booleen."
    },
    "constant": {
      "champs": {
        "value": {
          "requis": true,
          "type": "nombre"
        }
      },
      "resume": "Valeur litterale, independante du contexte."
    },
    "crosses_above": {
      "champs": {
        "fast": {
          "requis": true,
          "type": "noeud"
        },
        "slow": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "`fast` passe au-dessus de `slow` entre t-1 et t."
    },
    "crosses_below": {
      "champs": {
        "fast": {
          "requis": true,
          "type": "noeud"
        },
        "slow": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "`fast` passe sous `slow` entre t-1 et t."
    },
    "cumulative": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        },
        "stat": {
          "choix": [
            "sum",
            "mean",
            "min",
            "max",
            "first",
            "last",
            "count_true"
          ],
          "requis": true,
          "type": "choix"
        }
      },
      "resume": "Cumul d'un sous-signal DEPUIS l'ouverture de la seance courante."
    },
    "if_then_else": {
      "champs": {
        "condition": {
          "requis": true,
          "type": "noeud"
        },
        "otherwise": {
          "requis": true,
          "type": "noeud"
        },
        "then": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "Choisit entre deux sous-signaux selon une condition."
    },
    "lag": {
      "champs": {
        "bars": {
          "min": 1,
          "requis": true,
          "type": "entier"
        },
        "inner": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "Evalue un sous-signal tel qu'il etait il y a `bars` barres."
    },
    "math": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        },
        "op": {
          "choix": [
            "abs",
            "neg",
            "sign",
            "log",
            "exp",
            "sqrt",
            "inverse",
            "floor",
            "ceil"
          ],
          "requis": true,
          "type": "choix"
        }
      },
      "resume": "Operation arithmetique UNAIRE sur un sous-signal."
    },
    "max_of": {
      "champs": {
        "operands": {
          "element": {
            "type": "noeud"
          },
          "min_elements": 1,
          "requis": true,
          "type": "liste"
        }
      },
      "resume": "Plus grande valeur parmi plusieurs sous-signaux."
    },
    "min_of": {
      "champs": {
        "operands": {
          "element": {
            "type": "noeud"
          },
          "min_elements": 1,
          "requis": true,
          "type": "liste"
        }
      },
      "resume": "Plus petite valeur parmi plusieurs sous-signaux."
    },
    "not": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        }
      },
      "resume": "Negation booleenne."
    },
    "peer": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        },
        "symbol": {
          "requis": true,
          "type": "texte"
        }
      },
      "resume": "Evalue un sous-signal sur un AUTRE instrument, au meme instant."
    },
    "position": {
      "champs": {
        "field": {
          "choix": [
            "quantity",
            "direction",
            "bars_held",
            "entry_price",
            "high_since_entry",
            "low_since_entry"
          ],
          "defaut": "quantity",
          "type": "choix"
        }
      },
      "resume": "Feuille : ce que la strategie sait de SA propre position."
    },
    "price": {
      "champs": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "lag": {
          "defaut": 0,
          "min": 0,
          "type": "entier"
        }
      },
      "resume": "Feuille : un champ OHLCV de la barre courante ou passee."
    },
    "primitive": {
      "champs": {
        "params": {
          "type": "objet"
        },
        "ref": {
          "choix": [
            "adx@1",
            "atr@1",
            "atr_wilder@1",
            "cci@1",
            "efficiency_ratio@1",
            "ema@1",
            "macd@1",
            "obv@1",
            "returns@1",
            "rolling_high@1",
            "rolling_low@1",
            "rsi@1",
            "rsi_wilder@1",
            "slope@1",
            "sma@1",
            "stdev@1",
            "stochastic@1",
            "true_range@1",
            "volatility@1",
            "vwap@1",
            "williams_r@1",
            "zscore@1"
          ],
          "note": "les `params` attendus dependent de la primitive choisie",
          "requis": true,
          "type": "choix"
        }
      },
      "resume": "Feuille : une primitive du registre, parametres figes."
    },
    "rolling": {
      "champs": {
        "inner": {
          "requis": true,
          "type": "noeud"
        },
        "stat": {
          "choix": [
            "mean",
            "stdev",
            "min",
            "max",
            "sum",
            "zscore",
            "ema",
            "median",
            "var",
            "slope",
            "rank",
            "count_true"
          ],
          "requis": true,
          "type": "choix"
        },
        "stride": {
          "defaut": 1,
          "min": 1,
          "type": "entier"
        },
        "window": {
          "min": 1,
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Statistique glissante d'un sous-signal QUELCONQUE, pas d'un champ de prix."
    },
    "session": {
      "champs": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume",
            "bar_index",
            "minutes_from_open",
            "is_first",
            "is_last"
          ],
          "defaut": "open",
          "type": "choix"
        },
        "lag": {
          "defaut": 0,
          "min": 0,
          "type": "entier"
        }
      },
      "resume": "Feuille : une grandeur de la seance courante ou d'une seance close."
    },
    "time": {
      "champs": {
        "field": {
          "choix": [
            "weekday",
            "hour",
            "minute",
            "day",
            "month",
            "day_of_year",
            "year"
          ],
          "defaut": "weekday",
          "type": "choix"
        }
      },
      "resume": "Feuille : un champ calendaire de la barre courante (UTC)."
    }
  },
  "primitives": {
    "adx@1": {
      "params": {
        "output": {
          "choix": [
            "adx",
            "plus_di",
            "minus_di"
          ],
          "defaut": "adx",
          "type": "choix"
        },
        "seed_multiplier": {
          "defaut": 5,
          "type": "entier"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Systeme directionnel de Wilder : `adx`, `plus_di` ou `minus_di` au choix."
    },
    "atr@1": {
      "params": {
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Average True Range, moyenne SIMPLE des True Ranges (pas le lissage de Wilder)."
    },
    "atr_wilder@1": {
      "params": {
        "seed_multiplier": {
          "defaut": 5,
          "type": "entier"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Average True Range lisse a la WILDER (a distinguer de `atr@1`, moyenne simple)."
    },
    "cci@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Commodity Channel Index sur le prix typique (high + low + close) / 3."
    },
    "efficiency_ratio@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Ratio d'efficience de Kaufman : trajet net rapporte au chemin parcouru."
    },
    "ema@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "seed_multiplier": {
          "defaut": 5,
          "type": "entier"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Moyenne exponentielle sur historique tronque, amorcee par une SMA."
    },
    "macd@1": {
      "params": {
        "fast": {
          "defaut": 12,
          "type": "entier"
        },
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "output": {
          "choix": [
            "line",
            "signal",
            "histogram"
          ],
          "defaut": "line",
          "type": "choix"
        },
        "seed_multiplier": {
          "defaut": 5,
          "type": "entier"
        },
        "signal": {
          "defaut": 9,
          "type": "entier"
        },
        "slow": {
          "defaut": 26,
          "type": "entier"
        }
      },
      "resume": "MACD : `line`, `signal` ou `histogram` au choix, sur historique tronque."
    },
    "obv@1": {
      "params": {
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "On-Balance Volume cumule sur FENETRE (pas depuis l'origine)."
    },
    "returns@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "log": {
          "defaut": false,
          "type": "booleen"
        },
        "window": {
          "defaut": 1,
          "type": "entier"
        }
      },
      "resume": "Rendement sur `window` barres, simple ou logarithmique."
    },
    "rolling_high@1": {
