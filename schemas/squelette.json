  "specification": {
    "check_invariant": {
      "defaut": true,
      "type": "booleen"
    },
    "data": {
      "element": {
        "champs": {
          "alias": {
            "accepte_null": true,
            "defaut": null,
            "type": "texte"
          },
          "allow_non_positive_prices": {
            "defaut": true,
            "type": "booleen"
          },
          "close_stamp": {
            "choix": [
              "period_end",
              "last_bar"
            ],
            "defaut": "period_end",
