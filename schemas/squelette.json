    },
    "vwap@1": {
      "params": {
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Prix moyen pondere par les volumes, sur FENETRE (pas sur la seance)."
    },
    "williams_r@1": {
      "params": {
        "field": {
          "choix": [
