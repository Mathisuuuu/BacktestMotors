            "volume"
          ],
          "defaut": "low",
          "type": "choix"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Plus bas des `window` dernieres barres closes."
    },
    "rsi@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Relative Strength Index, moyennes SIMPLES des hausses et des baisses."
    },
    "rsi_wilder@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "seed_multiplier": {
          "defaut": 5,
          "type": "entier"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Relative Strength Index lisse a la WILDER (a distinguer de `rsi@1`)."
    },
    "slope@1": {
      "params": {
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "window": {
          "requis": true,
          "type": "entier"
        }
      },
      "resume": "Pente d'une regression lineaire sur la fenetre, en unites par barre."
    },
    "sma@1": {
