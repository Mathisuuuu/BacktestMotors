          "type": "entier"
        },
        "field": {
          "choix": [
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "defaut": "close",
          "type": "choix"
        },
        "log": {
          "defaut": false,
          "type": "booleen"
        },
