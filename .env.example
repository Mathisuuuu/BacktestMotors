# Modele a copier en `.env` a la racine du depot, puis a adapter.
#
#     cp .env.example .env
#
# `.env` n'est pas versionne : chaque machine declare sa propre racine.
# La variable d'environnement `RSL_DATA_DIR`, si elle est definie, l'emporte
# sur ce fichier.
#
# La racine doit contenir l'arborescence des cotations :
#     <racine>/indices/ES_v0_1m.parquet
#     <racine>/metaux/GC_v0_1m.parquet
#     <racine>/energie/CL_v0_1m.parquet
#     <racine>/forex/6E_v0_1m.parquet
RSL_DATA_DIR=C:/chemin/vers/Cotations
