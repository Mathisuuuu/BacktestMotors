{
  "name": "rsi-survendu-hors-lundi",
  "initial_cash": 500000.0,
  "seed": 0,
  "data": [
    { "root": "ES", "path": "indices/ES_v0_1m.parquet",
      "granularity_minutes": 1, "resample": "day", "resample_min_bars": 200 }
  ],
  "execution": {
    "fees": { "kind": "per_contract" },
    "slippage": { "kind": "tick", "ticks": 1.0 },
    "lag_bars": 1, "intrabar_priority": "pessimistic", "margin_policy": "reject"
  },
  "risk": { "sizing": { "kind": "fixed", "contracts": 1 } },
  "strategy": {
    "ref": "rules@1",
    "params": {
      "symbol": "ES.v.0",
      "quantity": 1,
      "rules": {
        "entry_long": {
          "type": "all_of",
          "operands": [
            { "type": "compare", "op": "<",
              "left":  { "type": "primitive", "ref": "rsi@1", "params": { "window": 14 } },
              "right": { "type": "constant", "value": 30.0 } },
            { "type": "compare", "op": ">",
              "left":  { "type": "time", "field": "weekday" },
              "right": { "type": "constant", "value": 0.0 } }
          ]
        },
        "exit_long": {
          "type": "any_of",
          "operands": [
            { "type": "compare", "op": ">",
              "left":  { "type": "primitive", "ref": "rsi@1", "params": { "window": 14 } },
              "right": { "type": "constant", "value": 55.0 } },
            { "type": "compare", "op": ">=",
              "left":  { "type": "position", "field": "bars_held" },
              "right": { "type": "constant", "value": 15.0 } }
          ]
        },
        "stop_loss": {
          "type": "arith", "op": "-",
          "left":  { "type": "price", "field": "close" },
          "right": { "type": "arith", "op": "*",
                     "left":  { "type": "constant", "value": 2.5 },
                     "right": { "type": "primitive", "ref": "atr@1", "params": { "window": 20 } } }
        }
      }
    }
  }
}
