                                "lag": 0
                              }
                            }
                          },
                          "right": {
                            "type": "cumulative",
                            "stat": "sum",
                            "inner": {
                              "type": "price",
                              "field": "volume",
                              "lag": 0
                            }
                          },
                          "note": "VWAP ANCRE sur la seance declaree, sur le prix typique."
                        }
                      },
                      "right": {
                        "type": "constant",
                        "value": 1.0
                      }
                    }
