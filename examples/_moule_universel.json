{
  "name": "moule-universel",
  "initial_cash": 200000.0,
  "seed": 0,
  "risk_free_annual": 0.0,
  "min_warmup_bars": 0,
  "liquidate_at_end": false,

  "data": [
    {
      "root": "ES",
      "path": "indices/ES_v0_1m.parquet",
      "granularity_minutes": 1,
      "resample": "day",
      "resample_min_bars": 200
    },
    {
      "root": "NQ",
      "path": "indices/NQ_v0_1m.parquet",
      "granularity_minutes": 1,
      "resample": "day",
      "resample_min_bars": 200
    }
  ],

  "panel": { "align_policy": "drop", "max_ffill_bars": null },

  "execution": {
    "fees": { "kind": "per_contract" },
    "slippage": { "kind": "tick", "ticks": 1.0 },
    "lag_bars": 1,
    "intrabar_priority": "pessimistic",
    "margin_policy": "reject"
  },

  "risk": {
    "sizing": { "kind": "fixed", "contracts": 1 },
    "max_gross_contracts": null
  },

  "strategy": {
    "ref": "panel_rules@1",
    "params": {
      "symbol": "ES.v.0",
      "quantity": 1,
      "allow_pyramiding": false,
      "extra_warmup": 0,

      "rules": {
        "entry_long": {
          "type": "all_of",
          "operands": [
            {
              "type": "crosses_above",
              "fast": { "type": "primitive", "ref": "macd@1",
                        "params": { "fast": 12, "slow": 26, "output": "line" } },
              "slow": { "type": "primitive", "ref": "macd@1",
                        "params": { "fast": 12, "slow": 26, "signal": 9, "output": "signal" } }
            },
            {
              "type": "compare", "op": ">",
              "left": { "type": "primitive", "ref": "adx@1",
                        "params": { "window": 14, "output": "adx" } },
              "right": { "type": "constant", "value": 18.0 }
            },
            {
              "type": "compare", "op": "<",
              "left": {
                "type": "math", "op": "abs",
                "inner": {
                  "type": "rolling", "stat": "zscore", "window": 120,
                  "inner": {
                    "type": "arith", "op": "/",
                    "left": { "type": "price", "field": "close" },
                    "right": { "type": "peer", "symbol": "NQ.v.0",
                               "inner": { "type": "price", "field": "close" } }
                  }
                }
              },
              "right": { "type": "constant", "value": 2.5 }
            },
            {
              "type": "not",
              "inner": {
                "type": "compare", "op": "==",
                "left": { "type": "time", "field": "weekday" },
                "right": { "type": "constant", "value": 0.0 }
              }
            },
            {
              "type": "compare", "op": ">",
              "left": { "type": "rolling", "stat": "ema", "window": 10,
                        "inner": { "type": "price", "field": "close" } },
              "right": { "type": "lag", "bars": 5,
                         "inner": { "type": "rolling", "stat": "ema", "window": 10,
                                    "inner": { "type": "price", "field": "close" } } }
            }
          ]
        },

        "entry_short": {
          "type": "all_of",
          "operands": [
            {
              "type": "crosses_below",
              "fast": { "type": "primitive", "ref": "macd@1",
                        "params": { "fast": 12, "slow": 26, "output": "line" } },
              "slow": { "type": "primitive", "ref": "macd@1",
                        "params": { "fast": 12, "slow": 26, "signal": 9, "output": "signal" } }
            },
            {
              "type": "compare", "op": ">",
              "left": { "type": "primitive", "ref": "adx@1",
                        "params": { "window": 14, "output": "minus_di" } },
              "right": { "type": "primitive", "ref": "adx@1",
                         "params": { "window": 14, "output": "plus_di" } }
            },
            {
              "type": "compare", "op": "<",
              "left": { "type": "primitive", "ref": "efficiency_ratio@1",
                        "params": { "window": 20 } },
              "right": { "type": "constant", "value": 0.9 }
            }
          ]
        },

        "exit_long": {
          "type": "any_of",
          "operands": [
            {
              "type": "compare", "op": ">",
              "left": { "type": "primitive", "ref": "rsi_wilder@1", "params": { "window": 14 } },
              "right": { "type": "constant", "value": 72.0 }
            },
            {
              "type": "compare", "op": ">=",
              "left": { "type": "position", "field": "bars_held" },
              "right": { "type": "constant", "value": 45.0 }
            },
            {
              "type": "compare", "op": "<=",
              "left": { "type": "bars_since", "lookback": 15,
                        "inner": { "type": "compare", "op": "<",
                                   "left": { "type": "primitive", "ref": "cci@1",
                                             "params": { "window": 20 } },
                                   "right": { "type": "constant", "value": -180.0 } } },
              "right": { "type": "constant", "value": 1.0 }
            }
          ]
        },

        "exit_short": {
          "type": "any_of",
          "operands": [
            {
              "type": "compare", "op": "<",
              "left": { "type": "primitive", "ref": "williams_r@1", "params": { "window": 14 } },
              "right": { "type": "constant", "value": -88.0 }
            },
            {
              "type": "compare", "op": ">=",
              "left": { "type": "position", "field": "bars_held" },
              "right": { "type": "constant", "value": 30.0 }
            }
          ]
        },

        "stop_loss": {
          "type": "if_then_else",
          "condition": {
            "type": "compare", "op": ">",
            "left": { "type": "primitive", "ref": "efficiency_ratio@1",
                      "params": { "window": 20 } },
            "right": { "type": "constant", "value": 0.45 }
          },
          "then": {
            "type": "arith", "op": "-",
            "left": { "type": "position", "field": "high_since_entry" },
            "right": { "type": "arith", "op": "*",
                       "left": { "type": "constant", "value": 3.0 },
                       "right": { "type": "primitive", "ref": "atr_wilder@1",
                                  "params": { "window": 14 } } }
          },
          "otherwise": {
            "type": "arith", "op": "-",
            "left": { "type": "price", "field": "close" },
            "right": { "type": "arith", "op": "*",
                       "left": { "type": "constant", "value": 1.5 },
                       "right": { "type": "primitive", "ref": "atr_wilder@1",
                                  "params": { "window": 14 } } }
          }
        },

        "take_profit": {
          "type": "min_of",
          "operands": [
            {
              "type": "max_of",
              "operands": [
                { "type": "arith", "op": "+",
                  "left": { "type": "price", "field": "close" },
                  "right": { "type": "arith", "op": "*",
                             "left": { "type": "constant", "value": 5.0 },
                             "right": { "type": "primitive", "ref": "atr_wilder@1",
                                        "params": { "window": 14 } } } },
                { "type": "arith", "op": "*",
                  "left": { "type": "position", "field": "entry_price" },
                  "right": { "type": "constant", "value": 1.04 } }
              ]
            },
            { "type": "arith", "op": "*",
              "left": { "type": "price", "field": "close" },
              "right": { "type": "constant", "value": 1.15 } }
          ]
        }
      }
    }
  }
}
